{
  "name": "gavel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared",
    "mcp"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run typecheck && npm run build -w frontend && npm run build -w backend && npm run build:mcp",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "start": "npm run start -w backend",
    "setup": "node scripts/setup.mjs",
    "smoke:judge": "npm run smoke:judge -w backend",
    "smoke:latch": "npm run smoke:latch -w backend",
    "test": "npm run test -w backend",
    "build:mcp": "npm run build -w @agora/mcp",
    "configure:mcp": "node scripts/configure-mcp.mjs",
    "check:readiness": "node scripts/check-readiness.mjs",
    "smoke:auth": "node scripts/auth-smoke.mjs",
    "verify:tournament": "node scripts/verify-tournament.mjs",
    "verify:room": "tsx scripts/verify-room.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.5",
    "concurrently": "9.1.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "ws@>=8.0.0 <8.21.0": "8.21.0"
  }
}
