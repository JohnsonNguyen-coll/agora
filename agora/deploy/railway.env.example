# Copy these values into Railway > Service > Variables.
# Actual editable local copy: agora/.env.railway (ignored by Git).
NODE_ENV=production
HOST=::
SERVE_FRONTEND=false
# Railway injects PORT automatically; do not copy the local PORT.
# Exact public Vercel/custom frontend origin, no trailing slash:
APP_ORIGIN=
# Supabase > Connect > Session pooler (port 5432): copy the full URI.
# Insert your database password and URL-encode special characters.
# No anon/service_role/Supabase API key is used by this app.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5
# Supabase database CA certificate, PEM text; literal \n is accepted.
# Leave blank only if the server certificate verifies with Node's default CA store.
DATABASE_SSL_CA=
# Generated independently for production in .env.railway. Keep stable across redeploys.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
LATCH_PROXY_BASE=https://onlatch.com/proxy
# Smoke testing is local; participant latch tokens are submitted in the app.
