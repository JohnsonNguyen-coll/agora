# Copy into Vercel > Project > Settings > Environment Variables.
# Public HTTPS Railway backend origin, no /api suffix.
RAILWAY_BACKEND_URL=
# No VITE_ API URL: the browser calls /api on the frontend origin.
# Never place DATABASE_URL, session/encryption secrets, or Latch tokens here.

# Public Privy app ID, same as backend PRIVY_APP_ID; never include the app secret
VITE_PRIVY_APP_ID=
