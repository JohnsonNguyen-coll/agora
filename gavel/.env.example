# Local development. Production copies are under deploy/ and .env.railway/.env.vercel.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
SERVE_FRONTEND=true
# Keep SQLite locally, or paste your Supabase session-pooler connection URI here.
DATABASE_URL=file:./data/gavel.db
DATABASE_SSL=true
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
LATCH_PROXY_BASE=https://onlatch.com/proxy
# Real live smoke test only.
LATCH_SMOKE_TOKEN=
LATCH_MODEL=
